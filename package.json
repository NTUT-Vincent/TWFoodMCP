{
  "name": "twfoodmcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config worker/wrangler.jsonc",
    "deploy": "wrangler deploy --config worker/wrangler.jsonc",
    "check:deploy": "wrangler deploy --dry-run --config worker/wrangler.jsonc",
    "typecheck": "tsc --noEmit",
    "validate:data": "node scripts/validate-okf.mjs",
    "build:dataset": "node scripts/build-kv-dataset.mjs",
    "publish:dataset": "node scripts/publish-kv-dataset.mjs",
    "test": "node -e \"require('node:fs').rmSync('.test-dist',{recursive:true,force:true})\" && tsc -p tsconfig.test.json && node --test tests/*.test.mjs",
    "import:mcdonalds-okf": "node scripts/import-mcdonalds-okf.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260728.1",
    "typescript": "^5.8.3",
    "wrangler": "^4.114.0",
    "yaml": "^2.9.0"
  }
}
