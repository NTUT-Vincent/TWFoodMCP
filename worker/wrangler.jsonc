{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "okf-mcp",
  "main": "src/app.ts",
  "compatibility_date": "2026-07-31",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "twfoodmcp",
      "database_id": "e76c47b2-4fec-41d7-96b2-b0be6cf221f6",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "GITHUB_REPOSITORY": "NTUT-Vincent/TWFoodMCP",
    "GITHUB_DEFAULT_BRANCH": "main"
  }
  // Add secrets with: wrangler secret put GITHUB_TOKEN --config worker/wrangler.jsonc
  // and: wrangler secret put DRAFT_API_TOKEN --config worker/wrangler.jsonc
}
