{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "okf-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-31",
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "DATASET",
      "id": "287fcf25f7944885b0e5f290f7942ed6"
    }
  ],
  "vars": {
    "GITHUB_REPOSITORY": "NTUT-Vincent/TWFoodMCP",
    "GITHUB_DEFAULT_BRANCH": "main"
  }
  // Add secrets with: wrangler secret put GITHUB_TOKEN --config worker/wrangler.jsonc
  // and: wrangler secret put DRAFT_API_TOKEN --config worker/wrangler.jsonc
}
